generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AccountRole {
  admin
  consumer
  staff_field
  staff_backoffice
}

enum VerificationStatus {
  pending
  verified
  rejected
}

enum StaffRole {
  field
  backoffice
}

enum MeterStatus {
  active
  inactive
  removed
}

enum MeterType {
  automatic
  mechanical
}

enum ReadingMethod {
  remote
  manual
  photo_ocr
}

enum InvoiceStatus {
  draft
  confirmed
  issued
  paid
  void
}

enum JobScheduleType {
  weekly
  monthly
  yearly
}

enum JobRunStatus {
  running
  success
  failed
}

enum TariffStatus {
  active
  inactive
}

model JobDefinition {
  id             String          @id @default(uuid())
  name           String
  handlerKey     String
  scheduleType   JobScheduleType
  scheduleConfig Json
  enabled        Boolean         @default(true)
  maxAttempts    Int             @default(3)
  backoffSeconds Int             @default(60)
  nextRunAt      DateTime?
  lastRunAt      DateTime?
  lockedUntil    DateTime?
  lockedBy       String?
  deletedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  runs JobRun[]

  @@index([enabled, nextRunAt])
  @@index([deletedAt])
  @@index([handlerKey])
}

model JobRun {
  id         String       @id @default(uuid())
  jobId      String
  status     JobRunStatus
  attempt    Int          @default(1)
  runAt      DateTime     @default(now())
  finishedAt DateTime?
  error      String?      @db.Text
  resultSummary Json?

  job JobDefinition @relation(fields: [jobId], references: [id], onDelete: Cascade)
  overrideLogs InvoiceOverrideLog[]

  @@index([jobId])
  @@index([status])
  @@index([runAt])
}

enum InvoiceLineType {
  consumption
  fee
  vat
}

enum InvoiceReadingRole {
  start
  end
}

enum BarcodeStatus {
  pending
  accepted
  rejected
}

model Account {
  id                 String              @id @default(uuid())
  firstName          String
  lastName           String
  email              String              @unique
  phone              String?             @unique
  address            String
  passwordHash       String
  role               AccountRole
  verificationStatus VerificationStatus   @default(pending)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  consumerProfile ConsumerProfile?
  staffProfile     StaffProfile?
  verificationLogs VerificationLog[]
  meterConsumers   MeterConsumer[]
  readingsAsReader Reading[] @relation("ReadingReader")
  readingEdits     ReadingEdit[]
  invoices         Invoice[]
  invoiceOverrideLogs InvoiceOverrideLog[]
}

model ConsumerProfile {
  id            Int     @id @default(autoincrement())
  accountId     String  @unique
  householdSize Int
  tariffId      String?

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tariff  Tariff? @relation(fields: [tariffId], references: [id], onDelete: SetNull)

  @@index([tariffId])
}

model StaffProfile {
  id        Int      @id @default(autoincrement())
  accountId String   @unique
  staffRole StaffRole

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model VerificationLog {
  id         String             @id @default(uuid())
  accountId  String
  reviewerId String
  status     VerificationStatus
  note       String?
  reviewedAt DateTime           @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model Meter {
  id           String      @id @default(uuid())
  serialNumber String      @unique
  barcode      String?
  groupCode    String?
  address      String
  status       MeterStatus @default(active)
  type         MeterType   @default(mechanical)
  installedAt  DateTime?
  notes        String?     @db.Text
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  consumers MeterConsumer[]
  readings  Reading[]
  invoices  Invoice[]

  @@index([groupCode])
}

model MeterConsumer {
  meterId   String
  accountId String

  meter   Meter   @relation(fields: [meterId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([meterId, accountId])
  @@index([accountId])
}

model Reading {
  id                String        @id @default(uuid())
  meterId           String
  readerAccountId   String
  readAt            DateTime
  method            ReadingMethod
  value             Int
  originalValue     Int
  imageFilename     String?
  barcodeRaw        String?
  barcodeFinal      String?
  barcodeStatus     BarcodeStatus?
  barcodeUpdatedAt  DateTime?
  barcodeUpdatedBy  String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  meter           Meter    @relation(fields: [meterId], references: [id], onDelete: Cascade)
  readerAccount   Account  @relation("ReadingReader", fields: [readerAccountId], references: [id], onDelete: Cascade)
  edits           ReadingEdit[]
  invoiceLinks    InvoiceReadingLink[]

  @@index([meterId])
  @@index([readerAccountId])
  @@index([readAt])
}

model ReadingEdit {
  id          String      @id @default(uuid())
  readingId   String
  accountId   String
  editorRole  AccountRole
  value       Int
  reason      String?     @db.Text
  editedAt    DateTime    @default(now())

  reading Reading @relation(fields: [readingId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([readingId])
  @@index([accountId])
  @@index([editedAt])
}

model Tariff {
  id             String   @id @default(uuid())
  name           String
  basePrice      Decimal  @db.Decimal(12, 2)
  greenLimit     Int
  blueLimit      Int
  blueMultiplier Decimal  @db.Decimal(5, 2)
  redMultiplier  Decimal  @db.Decimal(5, 2)
  validFrom      DateTime
  validTo        DateTime?
  groupCode      String?
  status         TariffStatus @default(active)
  deletedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  invoices Invoice[]
  consumers ConsumerProfile[]

  @@index([status])
  @@index([deletedAt])
}

model Invoice {
  id           String        @id @default(uuid())
  accountId    String
  meterId      String?
  periodStart  DateTime?
  periodEnd    DateTime?
  status       InvoiceStatus @default(draft)
  consumption  Int
  unitPrice    Decimal       @db.Decimal(12, 2)
  subtotal     Decimal       @db.Decimal(12, 2)
  vatRate      Decimal       @db.Decimal(5, 2)
  vatAmount    Decimal       @db.Decimal(12, 2)
  totalAmount  Decimal       @db.Decimal(12, 2)
  tariffId     String?
  tariffSnapshot Json?
  reviewFlags  Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  account  Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  meter    Meter?  @relation(fields: [meterId], references: [id], onDelete: SetNull)
  tariff   Tariff? @relation(fields: [tariffId], references: [id], onDelete: SetNull)
  lines    InvoiceLine[]
  readings InvoiceReadingLink[]
  overrides InvoiceOverrideLog[]

  @@index([accountId])
  @@index([meterId])
  @@index([periodStart])
  @@index([periodEnd])
}

model InvoiceOverrideLog {
  id          String   @id @default(uuid())
  invoiceId   String
  adminId     String
  prevStatus  InvoiceStatus
  newStatus   InvoiceStatus
  reason      String?
  jobRunId    String?
  createdAt   DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  admin   Account @relation(fields: [adminId], references: [id], onDelete: Cascade)
  jobRun  JobRun? @relation(fields: [jobRunId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([adminId])
  @@index([jobRunId])
  @@index([createdAt])
}

model InvoiceLine {
  id          String          @id @default(uuid())
  invoiceId   String
  type        InvoiceLineType
  description String?
  quantity    Decimal?        @db.Decimal(12, 3)
  unitPrice   Decimal?        @db.Decimal(12, 2)
  amount      Decimal         @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model InvoiceReadingLink {
  id        String             @id @default(uuid())
  invoiceId String
  readingId String
  role      InvoiceReadingRole

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  reading Reading @relation(fields: [readingId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([readingId])
}

model AppSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
